# HTTP → HTTPS

server {
    listen 80;
    server_name 100.113.133.18;

    return 301 https://$host$request_uri;
}

# HTTPS SERVER
server {
    listen 443 ssl;
    server_name 100.113.133.18;

    # Certficado que hemos creado previamente con openssl
    ssl_certificate     /etc/nginx/ssl/sovereign-edge.crt;
    ssl_certificate_key /etc/nginx/ssl/sovereign-edge.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    
    #IA WEB (OPEN WEBUI)
    
    location / {
        proxy_pass http://localhost:3000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # websockets (OBLIGATORIO para chat IA)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_redirect off;
    }

    
    # OLLAMA API
    location /api/ollama/ {
        proxy_pass http://localhost:11434/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    
    # HONEYPOT PAGE
    
    location /honeypot.html {
        root /var/www/html;
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}
